# ============================================================
# Negociacoes SPA (frontend da aba "Outros" / navegadores remotos)
# Usado no build: `npm run build:negociacoes`
# ============================================================

# OPÇÃO A (sem domínio, por IP + cert auto-assinado):
#   VITE_BROWSER_API_BASE=https://34.39.188.115
#   (IP da VM orquestradora kito-browser-fast; cert gerado por make-selfsigned.sh)
# OPÇÃO B (com domínio + cert gerenciado via LB):
#   VITE_BROWSER_API_BASE=https://navegador.seudominio.com
VITE_BROWSER_API_BASE=https://34.39.188.115

# API key que casa com KITO_API_KEY do orquestrador.
VITE_BROWSER_API_KEY=CHANGE_ME

# Identificador do usuário da aba Outros (teto de navegadores por usuário).
VITE_BROWSER_USER_ID=kito-app-user

# Teto de navegadores por usuário (deve casar com MAX_BROWSERS_PER_USER do orquestrador).
VITE_MAX_BROWSERS_PER_USER=8

# ============================================================
# Orquestrador (server/browser-orchestrator.js)
# ============================================================

# KITO_API_KEY=xxx
# BROWSERS_PER_VM=12
# MAX_BROWSERS_PER_USER=8
# PORT=3000
# GCP_PROJECT=project-60095631-56d2-433d-99d
# GCP_ZONE=us-central1-a
# ORCHESTRATOR_SERVICE_ACCOUNT=kito-orchestrator@project-60095631-56d2-433d-99d.iam.gserviceaccount.com
# BROWSER_IMAGE_FAMILY=kito-browser
# BROWSER_MACHINE_TYPE=e2-standard-4
# WARM_POOL=browser-vm-1,browser-vm-2
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxx   (opcional: estado em Supabase; sem ele usa sessions.json local)
